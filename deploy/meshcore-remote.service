# Installation: sudo cp deploy/meshcore-remote.service /etc/systemd/system/
#               sudo systemctl daemon-reload && sudo systemctl enable --now meshcore-remote
# Pfade und Benutzer ggf. anpassen. Der Benutzer braucht die Gruppe "dialout" (USB-Seriell).
[Unit]
Description=MeshCore Remote (Weboberfläche für den Node)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/meshcore-remote
ExecStart=/home/pi/meshcore-remote/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
# Spätestens nach 20 s hart beenden. Der Watchdog wartet beim Stoppen länger (stop_timeout_s + 30 s, mindestens 60 s),
# damit ein Update nie mit „Zeitüberschreitung“ abbricht, während systemd den Dienst gleich darauf doch beendet.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
